      {/* ───────── CTA ───────── */}
      <CTASection
        title="Get the Firewall Selection Guide"
        description="Vendor-neutral comparison of NGFW, UTM, and cloud options - with TCO analysis, throughput benchmarks, and real deployment case studies."
