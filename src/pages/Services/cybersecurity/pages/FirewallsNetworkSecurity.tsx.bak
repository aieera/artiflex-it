/* ───────── ZONE INSPECTOR (Hero aside) ───────── */

function ZoneInspector() {
  return (
    <div className="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.08] to-white/[0.02] shadow-[0_30px_80px_-20px_rgba(3,16,28,0.8)] backdrop-blur-md">
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#28B5E1]/70 to-transparent"
      />
      <div
        aria-hidden="true"
        className="pointer-events-none absolute -right-20 -top-24 h-60 w-60 rounded-full bg-[#28B5E1]/20 blur-[110px]"
      />
      <div
        aria-hidden="true"
        className="pointer-events-none absolute -bottom-20 -left-16 h-52 w-52 rounded-full bg-[#045891]/25 blur-[100px]"
      />

      {/* Panel header */}
      <div className="relative flex items-center justify-between border-b border-white/10 px-5 py-3">
        <div className="flex items-center gap-1.5">
          <span className="h-2 w-2 rounded-full bg-rose-400/80" />
          <span className="h-2 w-2 rounded-full bg-amber-400/80" />
          <span className="h-2 w-2 rounded-full bg-emerald-400/80" />
        </div>
        <p className="font-mono text-[10px] uppercase tracking-[0.22em] text-slate-400">
          firewall.hud <span className="text-slate-600">/</span> zone-inspector
        </p>
        <div className="flex items-center gap-1.5">
          <span className="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-emerald-400" />
          <span className="font-mono text-[9px] uppercase tracking-widest text-emerald-400">
            SYNC
          </span>
        </div>
      </div>

      {/* Radar / scope */}
      <div className="relative h-44 overflow-hidden border-b border-white/10 bg-[radial-gradient(ellipse_at_bottom,rgba(27,138,199,0.22),transparent_70%)]">
        <svg viewBox="0 0 400 160" className="absolute inset-0 h-full w-full">
          <defs>
            <linearGradient id="fwSweep" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0%" stopColor="#28B5E1" stopOpacity="0" />
              <stop offset="70%" stopColor="#28B5E1" stopOpacity="0.08" />
              <stop offset="100%" stopColor="#4FC3F7" stopOpacity="0.45" />
            </linearGradient>
          </defs>

          {[40, 80, 120, 160].map((r, i) => (
            <circle
              key={r}
              cx="200"
              cy="160"
              r={r}
              fill="none"
              stroke="#1B8AC7"
              strokeWidth="0.5"
              strokeDasharray={i % 2 ? "0" : "2 3"}
              opacity={0.35 - i * 0.05}
            />
          ))}

          <line x1="40" y1="160" x2="360" y2="160" stroke="#28B5E1" strokeWidth="0.4" opacity="0.4" />
          <line x1="200" y1="0" x2="200" y2="160" stroke="#28B5E1" strokeWidth="0.4" opacity="0.2" strokeDasharray="2 4" />

          <g className="fw-radar-sweep">
            <path d="M 200 160 L 200 0 A 160 160 0 0 1 360 160 Z" fill="url(#fwSweep)" />
          </g>

          <circle className="fw-blip" cx="132" cy="92" r="2" fill="#4FC3F7" />
          <circle className="fw-blip fw-blip-2" cx="264" cy="74" r="2" fill="#4FC3F7" />
          <circle className="fw-blip fw-blip-3" cx="298" cy="118" r="2" fill="#4FC3F7" />

          <circle cx="200" cy="160" r="3" fill="#28B5E1" />
          <circle cx="200" cy="160" r="6" fill="none" stroke="#28B5E1" strokeWidth="0.5" opacity="0.6" />
        </svg>

        <div className="absolute left-3 top-3 font-mono text-[9px] uppercase tracking-widest text-slate-400">
          Perimeter Scan · 360°
        </div>
        <div className="absolute right-3 top-3 font-mono text-[9px] uppercase tracking-widest text-slate-400">
          RANGE 5km
        </div>
        <div className="absolute bottom-3 right-3 font-mono text-[10px] text-[#4FC3F7]">
          4.91B <span className="text-slate-400">pkts/24h</span>
        </div>
      </div>

      {/* Zones list */}
      <div className="relative divide-y divide-white/5">
        {heroZones.map((item, i) => {
          const c = toneClasses[item.tone];
          return (
            <div
              key={item.zone}
              className="flex items-center justify-between px-5 py-2.5 transition hover:bg-white/[0.03]"
            >
              <div className="flex items-center gap-4">
                <span className="font-mono text-[10px] text-slate-500">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <p className="font-display text-[13px] font-medium text-white">
                    {item.zone}
                  </p>
                  <p className="font-mono text-[9px] uppercase tracking-[0.2em] text-slate-400">
                    {item.rule}
                  </p>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <span className={`h-1.5 w-1.5 rounded-full ${c.dot}`} />
                <span className={`font-mono text-[10px] font-semibold uppercase tracking-[0.18em] ${c.text}`}>
                  {item.status}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      {/* Log footer */}
      <div className="relative border-t border-white/10 px-5 pb-3 pt-3">
        <div className="flex items-center justify-between">
          <p className="font-mono text-[9px] uppercase tracking-widest text-slate-400">
            <span className="text-[#4FC3F7]">$</span> tail -f /var/log/fw.log
          </p>
          <span className="font-mono text-[9px] uppercase tracking-widest text-emerald-400">
            streaming
          </span>
        </div>
        <div
          className="mt-2 h-20 overflow-hidden"
          style={{
            maskImage:
              "linear-gradient(to bottom, transparent 0%, black 18%, black 80%, transparent 100%)",
            WebkitMaskImage:
              "linear-gradient(to bottom, transparent 0%, black 18%, black 80%, transparent 100%)",
          }}
        >
          <div className="fw-log-scroll space-y-1">
            {[...heroLog, ...heroLog].map((e, i) => (
              <LogRow key={i} entry={e} />
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

