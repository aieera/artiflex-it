# ==============================================================
# .htaccess — Artiflex IT (artiflexit.com) on Hostinger Apache
# Works for a PRE-RENDERED Vite + React SPA.
# Expected layout inside public_html:
#   /index.html                     <-- SPA fallback
#   /cybersecurity/index.html       <-- pre-rendered
#   /business-solutions/.../…       <-- pre-rendered
#   /assets/… /logos/… /images/…    <-- static
# ==============================================================

# --------------------------------------------------------------
# 1.  MIME types for modern assets
# --------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType image/avif                .avif
  AddType image/svg+xml             .svg .svgz
  AddType application/manifest+json .webmanifest
  AddType font/woff2                .woff2
  AddType font/woff                 .woff
  AddType application/wasm          .wasm
  AddType text/xml                  .xml
  AddType application/xml           .xml
</IfModule>

# --------------------------------------------------------------
# 2.  Default document
# --------------------------------------------------------------
DirectoryIndex index.html

# Never append a trailing slash to directory URLs. Every pre-rendered
# route is a directory (/<route>/index.html); its canonical URL has NO
# trailing slash, and rule 3c 301s the slash form away. With mod_dir's
# default (DirectorySlash On) the two would fight. Rule 3d serves the
# directory's index.html internally, so the slash is never needed.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# --------------------------------------------------------------
# 3.  Rewrite engine
# --------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3a. Force HTTPS + non-www in ONE rule (canonical host = artiflexit.com).
  #     Combined so a backlink to http://, www., or http://www. resolves in a
  #     single 301 instead of chaining through two separate redirects. Fewer
  #     hops = less link-equity loss and faster crawling of inbound links.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.artiflexit\.com$ [NC]
  RewriteRule ^ https://artiflexit.com%{REQUEST_URI} [L,R=301]

  # 3a-ii. Serve the PRE-COMPRESSED twin of a static asset when one exists.
  #
  #        The Vite build (vite-plugin-compression, see vite.config.ts)
  #        already writes <file>.br next to every JS / CSS / SVG asset at
  #        build time. Until 2026-08-24 nothing ever served them: section
  #        4 below only configures ON-THE-FLY compression, so Apache spent
  #        CPU re-compressing identical bytes on every request (slower
  #        TTFB, therefore slower LCP) while ~250 pre-compressed files sat
  #        in the deploy as dead weight.
  #
  #        These rules do the content negotiation by hand: if the client
  #        advertises the encoding AND the twin actually exists on disk,
  #        rewrite to it. The "-f" test means we can never rewrite to a
  #        file that is not there, so this is a silent no-op for any asset
  #        that was not pre-compressed.
  #
  #        Scope is deliberately js / css / svg only. HTML stays on
  #        on-the-fly compression because it would interact with the
  #        pre-rendered-route rewrite (3d) and the 404 handler (section 8).
  #
  #        The matching Content-Type / Content-Encoding headers live in
  #        section 5 (mod_headers). BOTH halves are required. Removing
  #        either one on its own WILL break asset delivery.
  #
  #        Rollback: comment out the four rules below AND the ".br / .gz
  #        twin" FilesMatch blocks in section 5.

  #        NOTE on $1 inside RewriteCond: Apache matches the RewriteRule
  #        PATTERN first and only then evaluates the conditions, so the
  #        rule's capture group is available here. %{DOCUMENT_ROOT}/$1 is
  #        used in preference to %{REQUEST_FILENAME} because the latter is
  #        not guaranteed to be a fully resolved filesystem path on the
  #        first pass through a per-directory (.htaccess) ruleset.

  #        FAIL-SAFE: the whole block is nested inside a mod_headers
  #        guard on purpose. Without mod_headers the Content-Encoding
  #        header could never be set, and the browser would receive
  #        brotli bytes labelled as octet-stream, which breaks every
  #        stylesheet and script on the site. If mod_headers is ever
  #        absent, we must fall back to serving the plain files, so the
  #        rewrite simply does not exist in that case.
  <IfModule mod_headers.c>
    # Brotli, preferred (roughly 20% smaller than gzip on our bundles).
    RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*br(\s*[;,]|$)
    RewriteCond %{DOCUMENT_ROOT}/$1.br -f
    RewriteRule ^(.+\.(?:js|css|svg))$ /$1.br [L]

    # gzip fallback for clients that do not advertise brotli.
    RewriteCond %{HTTP:Accept-Encoding} (^|,)\s*gzip(\s*[;,]|$)
    RewriteCond %{DOCUMENT_ROOT}/$1.gz -f
    RewriteRule ^(.+\.(?:js|css|svg))$ /$1.gz [L]
  </IfModule>

  # 3b-i. 301 redirects for retired URLs.
  #       Keep this list alphabetical. Every entry is a permanent
  #       redirect — Google will update its index within 1–2 crawls.
  RewriteRule ^amc-services/?$ /managed-services [L,R=301]
  RewriteRule ^business-solutions/document-management-system/?$ /infrastructure/document-management-systems [L,R=301]
  RewriteRule ^business-solutions/sales-management-software/?$ /business-solutions/crm-software [L,R=301]
  RewriteRule ^business-solutions/unified-firewall-management/?$ /cybersecurity/unified-firewall-management [L,R=301]
  RewriteRule ^cloud-solutions/disaster-recovery/?$ /cloud-solutions/disaster-recovery-solutions-dubai [L,R=301]
  RewriteRule ^cybersecurity/cybersecurity-solutions/?$ /cybersecurity [L,R=301]
  RewriteRule ^cybersecurity/email-security-vendors/?$ /cybersecurity/email-security [L,R=301]
  RewriteRule ^cybersecurity/endpoint/sophos-intercept-x/?$ /cybersecurity/endpoint/sophos-endpoint [L,R=301]
  RewriteRule ^cybersecurity/iam/one-identity/?$ /cybersecurity/iga/one-identity-manager [L,R=301]
  RewriteRule ^cybersecurity/iam/saviynt/?$ /cybersecurity/iga/saviynt [L,R=301]
  RewriteRule ^disaster-recovery-solutions-dubai/?$ /cloud-solutions/disaster-recovery-solutions-dubai [L,R=301]

  # 3b-ii. Block spam-injected URL patterns with HTTP 410 Gone.
  #        Backlinks from low-quality sites point at random numeric paths
  #        (e.g. /743137154, /876121755, /comment.php?798816093) trying
  #        to game our domain. 410 = "permanently removed" — Google
  #        deindexes 410s noticeably faster than 404s.
  RewriteRule ^[0-9]+/?$ - [R=410,L]
  RewriteRule ^comment\.php$ - [R=410,L]
  # Also catch numeric paths with an extra slug, e.g. /743137154/anything
  RewriteRule ^[0-9]+/.+ - [R=410,L]

  # 3b-iii. Extend 410 to leftover WordPress-era paths from the old site.
  #         None of these are real routes on the current Vite site (the real
  #         blog categories live under /blog/category/…, not /category/…), so
  #         a firm 410 deindexes them faster than the 404 handler.
  RewriteRule ^(feed|comments/feed)/?$ - [R=410,L]
  RewriteRule ^(category|tag|author)/ - [R=410,L]
  RewriteRule ^(index\.php|xmlrpc\.php|wp-login\.php)$ - [R=410,L]
  RewriteRule ^wp-(admin|content|includes|json)(/|$) - [R=410,L]
  RewriteRule ^(sitemap_index|wp-sitemap)\.xml$ - [R=410,L]

  # 3b-iv. Strip legacy JUNK numeric query strings, e.g. /?174015030 -> /
  #        Google lists thousands of these under "alternate page with proper
  #        canonical". A real UTM or ad-click tag ALWAYS contains "=" (e.g.
  #        utm_campaign=firewall-post), so a digits-only query string is always
  #        old junk and safe to drop. This never touches utm_*, gclid, fbclid.
  RewriteCond %{QUERY_STRING} ^[0-9]+$
  RewriteRule ^ https://artiflexit.com%{REQUEST_URI}? [L,R=301]

  # 3c. Remove trailing slashes (except root), in ONE 301, to the
  #     canonical https://artiflexit.com host.
  #     This used to carry "RewriteCond %{REQUEST_FILENAME} !-d", which
  #     exempted every PRE-RENDERED route, because each one is a real
  #     directory (dist/<route>/index.html). So /cybersecurity/ot-ics-security/
  #     answered 200 with the same HTML as the canonical URL (duplicate
  #     content, "Crawled - currently not indexed"). The condition is gone;
  #     "DirectorySlash Off" (section 2) stops mod_dir from re-adding the
  #     slash, so the redirect cannot loop, and rule 3d still serves
  #     /<route>/index.html for the slash-less URL.
  RewriteRule ^(.+)/$ https://artiflexit.com/$1 [L,R=301]

  # 3d. Serve pre-rendered /route/index.html when /route is requested
  #     If a directory with index.html exists for the clean URL, use it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^/]+(?:/[^/]+)*)$ /$1/index.html [L]

  # 3e. SPA-only routes that redirect via a URL fragment (#…). A fragment
  #     never reaches the server, so these cannot be a server-side 301 —
  #     they must boot the SPA with a 200 and let React Router redirect.
  RewriteRule ^cybersecurity/(vendor-scorecard|implementation-roadmap)/?$ /index.html [L]

  # 3f. NO catch-all to index.html. Every valid page is pre-rendered to its
  #     own /route/index.html (served by 3d) and listed in sitemap.xml, so
  #     any request that is not a real file, not a pre-rendered route, and
  #     not a SPA route above is genuinely unknown. It falls through to
  #     Apache's 404 handler (section 8), which serves the pre-rendered
  #     /404.html with a real HTTP 404 status.
  #     NOTE: a new valid page must be added to sitemap.xml (so prerender
  #     emits its HTML) or it will correctly 404 here.
</IfModule>

# --------------------------------------------------------------
# 4.  Compression (Brotli + gzip)
#     Brotli ships ~15-25% smaller payloads than gzip for text. We try
#     mod_brotli first, then fall back to mod_deflate (gzip). Both are
#     safe to define, Apache picks the available one.
# --------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html
  AddOutputFilterByType BROTLI_COMPRESS text/plain
  AddOutputFilterByType BROTLI_COMPRESS text/css
  AddOutputFilterByType BROTLI_COMPRESS text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS application/atom+xml
  AddOutputFilterByType BROTLI_COMPRESS application/xhtml+xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json
  AddOutputFilterByType BROTLI_COMPRESS application/ld+json
  AddOutputFilterByType BROTLI_COMPRESS application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/woff
  AddOutputFilterByType BROTLI_COMPRESS font/woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# --------------------------------------------------------------
# 5.  Browser caching
# --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — SHORT cache so deploys take effect fast
  ExpiresByType text/html                     "access plus 0 seconds"

  # Data
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType application/ld+json           "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"

  # Manifests / RSS
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresByType application/rss+xml           "access plus 1 hour"
  ExpiresByType application/atom+xml          "access plus 1 hour"

  # Favicons
  ExpiresByType image/x-icon                  "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon      "access plus 1 week"

  # Media
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # JS / CSS  (fingerprinted by Vite, safe to cache long)
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType application/x-javascript      "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Immutable cache for fingerprinted Vite assets
  <FilesMatch "\.(css|js|woff2|woff|ttf|eot|svg|webp|avif|jpg|jpeg|png|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ------------------------------------------------------------
  # .br / .gz twin handling (partner of rewrite rules 3a-ii above).
  #
  # Three things must happen for a pre-compressed file to be served
  # correctly, and all three are mandatory:
  #
  #   1. ForceType. The request was internally rewritten to e.g.
  #      "app.js.br", so Apache would otherwise resolve the type from
  #      the ".br" extension and hand the browser octet-stream. With
  #      X-Content-Type-Options: nosniff set below, a module script
  #      served under a non-JS type is REJECTED outright. Force the
  #      original type back on.
  #
  #   2. Content-Encoding, so the browser decompresses before parsing.
  #
  #   3. no-gzip / no-brotli. Section 4 enables output compression by
  #      Content-Type, and step 1 just declared these files to be
  #      text/javascript and text/css. Without these env vars Apache
  #      would compress an ALREADY compressed body a second time and
  #      the browser would receive garbage. Do not remove them.
  #
  # Vary: Accept-Encoding stops a shared proxy from handing a brotli
  # body to a client that never asked for one.
  #
  # The immutable cache header has to be repeated here because the
  # FilesMatch above keys on a ".js" / ".css" / ".svg" suffix, and
  # "app.js.br" does not end in ".js".
  # ------------------------------------------------------------
  <FilesMatch "\.js\.(br|gz)$">
    ForceType text/javascript
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header append Vary "Accept-Encoding"
    SetEnv no-gzip 1
    SetEnv no-brotli 1
  </FilesMatch>
  <FilesMatch "\.css\.(br|gz)$">
    ForceType text/css
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header append Vary "Accept-Encoding"
    SetEnv no-gzip 1
    SetEnv no-brotli 1
  </FilesMatch>
  <FilesMatch "\.svg\.(br|gz)$">
    ForceType image/svg+xml
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header append Vary "Accept-Encoding"
    SetEnv no-gzip 1
    SetEnv no-brotli 1
  </FilesMatch>
  <FilesMatch "\.br$">
    Header set Content-Encoding "br"
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding "gzip"
  </FilesMatch>

  # NEVER serve STALE HTML: we want new deploys picked up instantly.
  #
  # "no-cache" already guarantees that. It lets the browser keep a copy
  # but requires it to revalidate with the server before reuse, so a
  # deploy is picked up on the very next request. Deploy freshness is
  # NOT changed by the edit below.
  #
  # "no-store" was REMOVED 2026-08-24 and must not be reinstated. It is
  # a strictly stronger directive that forbids storing the response at
  # all, and Chrome treats any page served with no-store as INELIGIBLE
  # FOR BACK/FORWARD CACHE. Every Back click therefore ran a full cold
  # navigation instead of an instant bfcache restore. bfcache restores
  # report near-zero LCP and INP into CrUX, so no-store was quietly
  # costing us Core Web Vitals field data on every multi-page session,
  # and the vendor comparison pages are cross-linked heavily enough that
  # this is most sessions.
  #
  # Pragma and Expires were the HTTP/1.0 companions of no-store. Every
  # browser we support ignores them once Cache-Control is present, so
  # they go too.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ------------------------------------------------------------
  # 6.  Security headers
  # ------------------------------------------------------------
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-XSS-Protection "1; mode=block"

  # CORS for fonts (harmless; avoids cross-origin font blocks)
  <FilesMatch "\.(woff|woff2|ttf|eot|otf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------
# 7.  Hotlink / sensitive file protection
# --------------------------------------------------------------
# Block source-map files only. (Do NOT use "\.ht.*" — it matches .html too
# and would return 403 for every pre-rendered page on the site.)
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>

# Block specific sensitive filenames by exact match.
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|\.env\..*|\.gitignore|\.gitattributes|composer\.json|package\.json|package-lock\.json|tsconfig\..*\.json|tsconfig\.json|vite\.config\..*|eslint\.config\..*)$">
  Require all denied
</FilesMatch>

# Allow the two files the site needs to serve at the root
<Files "robots.txt">
  Require all granted
</Files>
<Files "sitemap.xml">
  Require all granted
</Files>

# --------------------------------------------------------------
# 8.  Custom 404 — pre-rendered static page served WITH a real 404 status.
#     scripts/prerender.mjs snapshots the React 404 route to dist/404.html.
# --------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------
# 9.  Misc
# --------------------------------------------------------------
ServerSignature Off
Options -Indexes
